# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# POLLINATIONS_API_KEY: Optional Pro key for pollinations.ai
# Provides higher limits and better quality for image generation.
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"

# CLAUDE_CODE_OAUTH_TOKEN: Token subskrypcji Claude Pro/Max dla agentów Triady.
# Wygeneruj go poleceniem `claude setup-token` (Claude Code) i wklej tutaj / w Secrets.
# Zużywa miesięczny kredyt Agent SDK z subskrypcji. Zamiast niego można podać ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN="MY_CLAUDE_CODE_OAUTH_TOKEN"

# CLAUDE_MODEL: Model Claude dla Triady: sonnet (domyślnie), haiku albo opus.
CLAUDE_MODEL="sonnet"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
